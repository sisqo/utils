LABEL[claudejobs]="File temporanei dei job di Claude"; TIER[claudejobs]=2; SUDO[claudejobs]=0; ICON[claudejobs]=$''
DESC[claudejobs]="tmp dei job conclusi da almeno un giorno (stato e cronologia restano)"
# Solo job in uno stato finale, non fissati in pins.json e fermi da piu' di un giorno.
claudejobs_dirs() {
    local j id st pins
    pins=$(cat "$H/.claude/jobs/pins.json" 2>/dev/null)
    for j in "$H/.claude/jobs"/*/; do
        j=${j%/}; id=$(basename "$j")
        [[ -d $j/tmp && -f $j/state.json ]] || continue
        [[ $pins == *"\"$id\""* ]] && continue
        st=$(grep -m1 -oE '"state": *"[a-z]+"' "$j/state.json" | grep -oE '[a-z]+"$' | tr -d '"')
        [[ $st =~ ^(done|failed|error|cancell?ed|stopped)$ ]] || continue
        [[ -n $(find "$j/state.json" -mtime +0) ]] || continue
        echo "$j/tmp"
    done
}
size_claudejobs() { local p; mapfile -t p < <(claudejobs_dirs); size_of "${p[@]}"; }
list_claudejobs() { claudejobs_dirs; }
run_claudejobs() { local d; while IFS= read -r d; do empty_dir "$d"; done < <(claudejobs_dirs); }

LABEL[chromiumsnap]="Disinstalla Chromium (snap)"; TIER[chromiumsnap]=2; SUDO[chromiumsnap]=1; ICON[chromiumsnap]=$''
DESC[chromiumsnap]="snap remove --purge: via anche profilo, segnalibri e password di Chromium"
chromiumsnap_files() {
    command -v snap >/dev/null && snap list chromium >/dev/null 2>&1 || return 0
    echo "$H/snap/chromium"
    ls /var/lib/snapd/snaps/chromium_*.snap 2>/dev/null
}
size_chromiumsnap() { local p; mapfile -t p < <(chromiumsnap_files); size_of "${p[@]}"; }
# Quanti dati personali ha il profilo: e' quello che si perde disinstallando.
chromium_profile_summary() {
    local p="$H/snap/chromium/common/chromium/Default" bm=0 pw="?" ext=0
    [[ -d $p ]] || return 0
    [[ -f $p/Bookmarks ]] && bm=$(grep -c '"type": "url"' "$p/Bookmarks")
    [[ -d $p/Extensions ]] && ext=$(find "$p/Extensions" -mindepth 1 -maxdepth 1 -type d | wc -l)
    if [[ -f "$p/Login Data" ]] && command -v python3 >/dev/null; then
        # Il database e' bloccato mentre Chromium e' aperto: se ne legge una copia.
        pw=$(python3 - "$p/Login Data" "$TMPD/logins" 2>/dev/null <<'PY'
import shutil, sqlite3, sys
shutil.copy(sys.argv[1], sys.argv[2])
print(sqlite3.connect(sys.argv[2]).execute("select count(*) from logins").fetchone()[0])
PY
) || pw="?"
    fi
    echo "profilo: $bm segnalibri, ${pw:-?} password salvate, $ext estensioni"
}
list_chromiumsnap() { chromium_profile_summary; chromiumsnap_files; }
run_chromiumsnap() { sudo snap remove --purge chromium; }

