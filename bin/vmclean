# Programmi in esecuzione che rendono rischioso toccare una categoria.
check_skips() {
    local c
    for c in "${CATS[@]}"; do
        SKIP[$c]=""
        [[ -n ${TIMEDOUT[$c]:-} ]] && SKIP[$c]="non risponde dopo ${SCAN_TIMEOUT}s: riprova piu' tardi"
    done
    pgrep -x chrome >/dev/null 2>&1 && SKIP[chrome]="Chrome e' aperto: chiudilo prima"
    running "$H/.local/share/JetBrains/Toolbox/apps" || running 'com.intellij' \
        && SKIP[jbcache]="l'IDE JetBrains e' aperto: chiudilo prima"
    running "ms-playwright|puppeteer" && SKIP[browsers]="un browser di test e' in esecuzione"
    running 'claude-desktop' && SKIP[ccache]="Claude Desktop e' aperto: chiudilo prima"
    running '/usr/share/code/' && SKIP[vscode]="VS Code e' aperto: chiudilo prima"
    running 'google-chrome-headless|--headless' && SKIP[headless]="Chrome headless e' in esecuzione"
    running '/snap/chromium/' && SKIP[chromium]="Chromium e' aperto: chiudilo prima"
    SKIP[chromiumsnap]=${SKIP[chromium]}
    running 'next dev|next start|next build|next-server' \
        && SKIP[nextbuild]="un server Next.js e' in esecuzione"
}

# ── intestazione ──────────────────────────────────────────────────────────────
OS_NAME=$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-linux}")
KERNEL=$(uname -r)
HOST=$(hostname -s 2>/dev/null || uname -n)
read -r DISK_SIZE DISK_AVAIL < <(df -h --output=size,avail / | tail -1)
DISK_PCT0=$(disk_pct)
MODE_TXT="interattivo"; $PREVIEW_ONLY && MODE_TXT="solo anteprima"

ikv() {  # $1 etichetta, $2 valore plain, $3 larghezza → _kv
    trunc "$2" $(( $3 - 8 ))
    rpad "$1" 8; _kv="${C_MUT}${_r}${C_TXT}${_t}${RST}"
}

# Colonna di informazioni a destra del banner, 6 righe → INFO[]
build_info() {  # $1 larghezza
    local sw=$1 u="${USER:-user}@${HOST}"
    INFO=()
    trunc "$u" "$sw"
    INFO+=("${C_PNK}${BLD}${USER:-user}${NOB}${C_MUT}@${C_CYN}${BLD}${HOST}${RST}")
    hr $(( ${#u} < sw ? ${#u} : sw )); INFO+=("${C_BRD}${_hr}${RST}")
    ikv os "$OS_NAME" "$sw";  INFO+=("$_kv")
    ikv kernel "$KERNEL" "$sw"; INFO+=("$_kv")
    meter "$DISK_PCT0" 12
    INFO+=("${C_MUT}disco${RST}   ${_m} ${C_TXT}${DISK_PCT0}%${RST}")
    ikv libero "$DISK_AVAIL di $DISK_SIZE" "$sw"; INFO+=("$_kv")
}

banner_frame() {  # $1 fase del gradiente, $2 larghezza colonna info (0 = niente)
    local phase=$1 sw=$2 r c ch idx out line
    for (( r=0; r<6; r++ )); do
        line=${BANNER[r]}; out=""
        for (( c=0; c<${#line}; c++ )); do
            ch=${line:c:1}
            if [[ $ch == ' ' ]]; then out+=' '; continue; fi
            idx=$(( (c + r * 2 - phase + 480) % 48 ))
            if [[ $ch == '█' ]]; then out+="${GRAD[idx]}$ch"; else out+="${GRAD_DIM[idx]}$ch"; fi
        done
        (( sw > 0 )) && out+="${RST}    ${INFO[r]}"
        (( TTY )) && printf '\033[2K'
        printf '  %s%s\n' "$out" "$RST"
    done
}

draw_header() {
    local sw=0 f
    echo
    if (( COLS < BANNER_W + 4 )); then
        printf '  %s%svmclean%s %s▸ pulizia della VM · %s%s\n\n' \
            "${GRAD[0]}" "$BLD" "$RST" "$C_MUT" "$MODE_TXT" "$RST"
        return
    fi
    (( COLS >= BANNER_W + 2 + 4 + 28 )) && sw=$(( COLS - BANNER_W - 2 - 4 - 1 ))
    (( sw > 40 )) && sw=40
    (( sw > 0 )) && build_info "$sw"
    banner_frame 0 "$sw"
    # Breve passata del gradiente sul banner, come l'animazione di cla2.
    if (( ANIM && COLOR )); then
        for (( f=3; f<=48; f+=3 )); do
            printf '\033[6A'; banner_frame "$f" "$sw"; sleep 0.02
        done
    fi
    printf '  %spulizia della VM %s·%s anteprima prima di cancellare %s·%s %s%s\n' \
        "$C_MUT" "$C_BRD" "$C_MUT" "$C_BRD" "$C_MUT" "$MODE_TXT" "$RST"
    if (( sw == 0 )); then
        meter "$DISK_PCT0" 12
        printf '  %s%s%s %s %s%s%% · %s liberi di %s%s\n' "$C_MUT" "$G_DISK" "$RST" "$_m" \
            "$C_TXT" "$DISK_PCT0" "$DISK_AVAIL" "$DISK_SIZE" "$RST"
    fi
    echo
}

# ── scansione (log in stile dmesg, come il boot di cla2) ─────────────────────
scan() {
    local t0 c n=0 e st busy=0 lab
    t0=${EPOCHREALTIME//[.,]/}
    blog() {
        (( TTY )) || return 0
        e=$(( ${EPOCHREALTIME//[.,]/} - t0 ))
        printf '  %s[%3d.%06d]%s %s\n' "$C_MUT" $(( e / 1000000 )) $(( e % 1000000 )) "$RST" "$1"
        n=$(( n + 1 ))
        (( ANIM )) && sleep 0.015
    }
    blog "${C_PUR}${BLD}vmclean${RST}: scan di ${#CATS[@]} categorie ${C_MUT}· $(id -un) · senza sudo${RST}"
    check_skips
    local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) pid k start out
    for c in "${CATS[@]}"; do
        rpad "${LABEL[$c]}" 38; lab=$_r
        # Il calcolo gira in background: se un comando esterno si blocca, la
        # categoria si salta invece di bloccare tutto, e intanto si vede quale
        # categoria si sta calcolando.
        out="$TMPD/size.$c"
        ( "size_$c" >"$out" 2>/dev/null ) &
        pid=$!; k=0; start=$SECONDS
        while kill -0 "$pid" 2>/dev/null; do
            if (( SECONDS - start >= SCAN_TIMEOUT )); then
                kill_tree "$pid"; TIMEDOUT[$c]=1
                SKIP[$c]="non risponde dopo ${SCAN_TIMEOUT}s: riprova piu' tardi"
                break
            fi
            (( TTY )) && printf '\r\033[K  %s[ %s%s%s  ]%s %s %s%s%s' "$C_MUT" "$C_CYN" \
                "${frames[k++ % 10]}" "$C_MUT" "$RST" "${ICON[$c]}" "$C_TXT" "${LABEL[$c]}" "$RST"
            sleep 0.1
        done
        wait "$pid" 2>/dev/null
        (( TTY )) && printf '\r\033[K'
        SIZE[$c]=$(< "$out") 2>/dev/null
        [[ ${SIZE[$c]} =~ ^[0-9]+$ ]] || SIZE[$c]=0
        if [[ -n ${TIMEDOUT[$c]:-} ]]; then
            st="${C_RED}[TIME]${RST} ${ICON[$c]} ${lab} ${C_RED}non risponde dopo ${SCAN_TIMEOUT}s${RST}"
        elif (( SIZE[$c] == 0 )); then
            st="${C_MUT}[ -- ] ${ICON[$c]} ${lab} vuota${RST}"
        elif [[ -n ${SKIP[$c]} ]]; then
            st="${C_YLW}[SKIP]${RST} ${ICON[$c]} ${lab} ${C_YLW}${SKIP[$c]}${RST}"
        else
            st="${C_GRN}[ OK ]${RST} ${ICON[$c]} ${C_TXT}${lab}${RST} ${C_CYN}$(human "${SIZE[$c]}")${RST}"
            busy=$(( busy + 1 ))
        fi
        blog "$st"
    done
    e=$(( ${EPOCHREALTIME//[.,]/} - t0 ))
    blog "${C_GRN}${BLD}ready${RST}. ${busy} categorie con spazio da liberare${C_PNK}▌${RST}"
    (( ANIM )) && sleep 0.3
    # Il log sparisce e resta solo il riepilogo: l'anteprima e' piu' sotto.
    (( TTY )) && printf '\033[%dA\033[J' "$n"
    printf '  %s%s%s scan completata in %d.%02ds %s·%s %d categorie %s·%s %d con qualcosa da liberare%s\n\n' \
        "$C_GRN" "$G_OK" "$C_MUT" $(( e / 1000000 )) $(( e % 1000000 / 10000 )) \
        "$C_BRD" "$C_MUT" "${#CATS[@]}" "$C_BRD" "$C_MUT" "$busy" "$RST"
}

# ── anteprima ────────────────────────────────────────────────────────────────

# Categorie selezionabili, nell'ordine (e con il numero) in cui compaiono.
AVAIL=()

cat_row() {  # $1 numero ("" se saltata), $2 categoria, $3 massimo, $4 colore
    local c=$2 col=$4 num lw size lock bar out
    local barseg=$(( BARW > 0 ? BARW + 2 : 0 ))
    lw=$(( IW - 15 - barseg ))
    printf -v num '%2s' "$1"
    trunc "${LABEL[$c]}" "$lw"; rpad "$_t" "$lw"
    if [[ -n ${TIMEDOUT[$c]:-} ]]; then lpad "?" 7; else lpad "$(human "${SIZE[$c]}")" 7; fi
    size=$_l
    lock=" "; (( SUDO[$c] )) && lock="${C_YLW}${G_LOCK}${RST}"
    if [[ -n $1 ]]; then
        bar=""; (( BARW )) && { gbar "${SIZE[$c]}" "$3" "$BARW"; bar="${_b}  "; }
        out="${col}${BLD}${num}${RST} ${col}${ICON[$c]}${RST} ${C_TXT}${BLD}${_r}${RST} ${bar}${C_CYN}${BLD}${size}${RST} ${lock}"
    else
        spaces "$barseg"; bar=$_s
        out="${C_MUT}${num} ${G_BAN} ${_r} ${bar}${size}${RST} ${lock}"
    fi
    box_line "$out" "$IW"
}

# Riga di dettaglio sotto una categoria: $1 ramo (├ └ o vuoto), $2 testo, $3 colore
det_line() {
    if [[ -z $1 ]]; then
        trunc "$2" $(( IW - 5 )); box_line "     $3${_t}${RST}" $(( 5 + ${#_t} ))
    else
        trunc "$2" $(( IW - 7 )); box_line "     ${C_BRD}$1${RST} $3${_t}${RST}" $(( 7 + ${#_t} ))
    fi
}

cat_block() {  # $1 numero ("" se saltata), $2 categoria, $3 massimo, $4 colore
    local c=$2 items=() k shown more br
    cat_row "$1" "$c" "$3" "$4"
    if [[ -n ${SKIP[$c]} ]]; then
        det_line "" "${G_WARN} saltata: ${SKIP[$c]}" "$C_YLW"
        return
    fi
    det_line "" "${DESC[$c]}" "$C_MUT"
    mapfile -t items < <("list_$c")
    shown=${#items[@]}; more=0
    (( shown > 5 )) && { more=$(( shown - 4 )); shown=4; }
    for (( k=0; k<shown; k++ )); do
        br="├"; (( k == shown - 1 && more == 0 )) && br="└"
        det_line "$br" "${items[k]/#$H/\~}" "$C_TXT"
    done
    (( more )) && det_line "└" "… e altri $more" "$C_MUT"
}

preview() {
    local c t i=0 total=0 total1=0 max=0 first title col
    for c in "${CATS[@]}"; do
        (( SIZE[$c] > max )) && max=${SIZE[$c]}
    done
    for t in 1 2; do
        first=1
        for c in "${CATS[@]}"; do
            (( TIER[$c] == t && (SIZE[$c] > 0 || ${TIMEDOUT[$c]:-0}) )) || continue
            if (( first )); then
                if (( t == 1 )); then
                    title="${G_SHIELD} CONSIGLIATE · si rigenerano da sole"; col=$C_GRN
                else
                    title="${G_WARN} OPZIONALI · hanno un costo, leggi la nota"; col=$C_YLW
                fi
                box_top "$title" "$col"
                first=0
            else
                box_line "" 0
            fi
            if [[ -n ${SKIP[$c]} ]]; then
                cat_block "" "$c" "$max" "$col"
                continue
            fi
            i=$(( i + 1 ))
            AVAIL+=("$c")
            total=$(( total + SIZE[$c] ))
            (( t == 1 )) && total1=$(( total1 + SIZE[$c] ))
            cat_block "$i" "$c" "$max" "$col"
        done
        (( first )) || { box_bot; echo; }
    done

    if (( ${#AVAIL[@]} == 0 )); then
        printf '  %s%s%s niente da pulire, la VM e'"'"' gia'"'"' in ordine.%s\n\n' "$C_GRN" "$G_OK" "$C_TXT" "$RST"
        return 1
    fi
    total=$(( total - $(chromium_overlap AVAIL) ))
    pl_seg " ${G_RECYCLE} VMCLEAN " "$R_PNK" "$R_DRK"
    pl_seg " ${#AVAIL[@]} categorie " "$R_SEG" "$R_TXT"
    pl_seg " ${G_SHIELD} consigliate $(human "$total1") " "$R_GRN" "$R_DRK"
    pl_seg " tutte $(human "$total") " "$R_YLW" "$R_DRK"
    (( COLS >= 90 )) && pl_seg " ${G_DISK} / ${DISK_PCT0}% · ${DISK_AVAIL} liberi " "$R_SEG" "$R_TXT"
    pl_end
    printf '  %s%s non toccati: sessioni e config di ~/.claude, la versione attiva di Claude Code,%s\n' \
        "$C_MUT" "$G_LOCK" "$RST"
    printf '  %s  node_modules dei progetti, kernel installati. %s%s%s = serve sudo%s\n' \
        "$C_MUT" "$C_YLW" "$G_LOCK" "$C_MUT" "$RST"
    return 0
}

# ── selezione ─────────────────────────────────────────────────────────────────

# Byte contati due volte se, nella lista $1 (nome di array), c'e' sia la
# disinstallazione di Chromium sia la sua cache o le revisioni snap vecchie.
chromium_overlap() {
    local -n _list=$1
    local over=0 f
    [[ " ${_list[*]} " == *" chromiumsnap "* ]] || { echo 0; return; }
    [[ " ${_list[*]} " == *" chromium "* ]] && over=$(( over + SIZE[chromium] ))
    if [[ " ${_list[*]} " == *" snap "* ]]; then
        while read -r name rev; do
            f="/var/lib/snapd/snaps/chromium_${rev}.snap"
            [[ $name == chromium && -f $f ]] && over=$(( over + $(stat -c %s -- "$f") ))
        done < <(snap_disabled)
    fi
    echo "$over"
}

# La disinstallazione di Chromium comprende gia' la pulizia della sua cache.
dedupe_chosen() {
    local c out=()
    [[ " ${CHOSEN[*]} " == *" chromiumsnap "* ]] || return 0
    for c in "${CHOSEN[@]}"; do [[ $c == chromium ]] || out+=("$c"); done
    CHOSEN=("${out[@]}")
}

select_cats() {
    local answer n c bad
    while true; do
        CHOSEN=()
        echo
        printf '  '; hint c consigliate; hint t tutte; hint "1-${#AVAIL[@]}" "scegli (es. 1 3 5)"
        hint "⏎" niente; printf '%s\n' "$RST"
        read -rp "  ${C_PNK}${G_SEP_R}${RST} " answer || return 1
        bad=""
        case "$answer" in
            ""|q|Q) return 1 ;;
            c|C) for c in "${AVAIL[@]}"; do (( TIER[$c] == 1 )) && CHOSEN+=("$c"); done ;;
            t|T) CHOSEN=("${AVAIL[@]}") ;;
            *)
                for n in ${answer//,/ }; do
                    if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#AVAIL[@]} )); then
                        c="${AVAIL[n-1]}"
                        [[ " ${CHOSEN[*]} " == *" $c "* ]] || CHOSEN+=("$c")
                    else
                        bad=$n; break
                    fi
                done
                ;;
        esac
        if [[ -n $bad ]]; then
            printf '  %s%s scelta non valida: %s%s\n' "$C_RED" "$G_WARN" "$bad" "$RST"
        elif (( ${#CHOSEN[@]} == 0 )); then
            printf '  %s%s nessuna categoria consigliata disponibile%s\n' "$C_YLW" "$G_WARN" "$RST"
        else
            dedupe_chosen
            return 0
        fi
    done
}

confirm() {
    local c total=0 need_sudo=0 answer lw size lock
    echo
    box_top "${G_WARN} DA ELIMINARE" "$C_PNK"
    lw=$(( IW - 13 ))
    for c in "${CHOSEN[@]}"; do
        trunc "${LABEL[$c]}" "$lw"; rpad "$_t" "$lw"
        lpad "$(human "${SIZE[$c]}")" 7; size=$_l
        lock=" "; (( SUDO[$c] )) && { lock="${C_YLW}${G_LOCK}${RST}"; need_sudo=1; }
        box_line " ${C_PNK}${ICON[$c]}${RST} ${C_TXT}${_r}${RST} ${C_CYN}${size}${RST} ${lock}" "$IW"
        total=$(( total + SIZE[$c] ))
    done
    total=$(( total - $(chromium_overlap CHOSEN) ))
    hr "$IW"; box_line "${C_BRD}${_hr}${RST}" "$IW"
    rpad "totale stimato" "$lw"; lpad "$(human "$total")" 7
    box_line "   ${C_TXT}${BLD}${_r}${NOB} ${C_CYN}${BLD}${_l}${RST}  " "$IW"
    box_bot
    (( need_sudo )) && printf '  %s%s alcune categorie usano sudo: la password viene chiesta ora%s\n' \
        "$C_YLW" "$G_LOCK" "$RST"
    echo
    read -rp "  ${C_PNK}${BLD}Confermi?${RST} ${C_MUT}[s/N]${RST} " answer || return 1
    [[ "$answer" == [sS] ]] || return 1
    if (( need_sudo )); then
        sudo -v -p "  ${G_LOCK} password di sudo per %u: " \
            || { printf '  %ssudo non disponibile: annullato.%s\n' "$C_RED" "$RST"; return 1; }
    fi
    return 0
}

# ── esecuzione ────────────────────────────────────────────────────────────────

step() {  # $1 esito (ok|warn|err|skip), $2 etichetta, $3 dettaglio
    local tag
    case $1 in
        ok)   tag="${C_GRN}[ OK ]" ;;
        warn) tag="${C_YLW}[WARN]" ;;
        err)  tag="${C_RED}[ERR ]" ;;
        *)    tag="${C_MUT}[ -- ]" ;;
    esac
    rpad "$2" 38
    printf '  %s%s %s%s%s %s%s\n' "$tag" "$RST" "$C_TXT" "$_r" "$RST" "$3" "$RST"
}

run_step() {  # $1 categoria
    local c=$1 log="$TMPD/$1.log" pid st k=0 before freed line
    local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    if [[ -n ${SKIP[$c]} ]]; then
        step skip "${LABEL[$c]}" "${C_YLW}saltata: ${SKIP[$c]}"
        return
    fi
    # Le credenziali di sudo scadono: si rinnovano in primo piano, dove si puo'
    # chiedere la password, prima di lanciare il passo in background.
    (( SUDO[$c] )) && ! sudo -n true 2>/dev/null && sudo -v -p "  ${G_LOCK} password di sudo per %u: "
    before=$(disk_avail)
    ( "run_$c" ) >"$log" 2>&1 </dev/null &
    pid=$!
    if (( TTY )); then
        printf '\033[?25l'
        while kill -0 "$pid" 2>/dev/null; do
            printf '\r  %s%s%s  %s %s%s%s' "$C_CYN" "${frames[k++ % 10]}" "$RST" \
                "${ICON[$c]}" "$C_TXT" "${LABEL[$c]}" "$RST"
            sleep 0.08
        done
        printf '\r\033[K\033[?25h'
    fi
    wait "$pid"; st=$?
    freed=$(( $(disk_avail) - before )); (( freed < 0 )) && freed=0
    if (( st != 0 )); then
        step err "${LABEL[$c]}" "${C_RED}uscita $st"
        grep -v '^NOTA: ' "$log" | tail -n 3 | while IFS= read -r line; do
            trunc "$line" $(( COLS - 12 )); printf '         %s%s%s\n' "$C_MUT" "$_t" "$RST"
        done
    elif grep -q '^NOTA: ' "$log"; then
        step warn "${LABEL[$c]}" "${C_CYN}$(human "$freed")"
    else
        step ok "${LABEL[$c]}" "${C_CYN}$(human "$freed")"
    fi
    grep '^NOTA: ' "$log" | while IFS= read -r line; do
        printf '         %s%s %s%s\n' "$C_YLW" "$G_WARN" "${line#NOTA: }" "$RST"
    done
}

run_all() {
    local c start after pct1
    start=$(disk_avail)
    echo
    printf '  %s%s%s pulizia in corso%s\n' "${GRAD[0]}" "$BLD" "$G_RECYCLE" "$RST"
    check_skips   # tra anteprima e conferma puo' essere stato aperto Chrome o l'IDE
    for c in "${CHOSEN[@]}"; do run_step "$c"; done
    after=$(disk_avail); pct1=$(disk_pct)
    echo
    meter "$DISK_PCT0" 12; local m0=$_m
    meter "$pct1" 12
    printf '  %s%s%s disco %s %s%s%%%s  %s→%s  %s %s%s%%%s\n' "$C_MUT" "$G_DISK" "$RST" \
        "$m0" "$C_TXT" "$DISK_PCT0" "$RST" "$C_PNK" "$RST" "$_m" "$C_TXT" "$pct1" "$RST"
    pl_seg " ${G_OK} FATTO " "$R_GRN" "$R_DRK"
    pl_seg " liberati $(human $(( after > start ? after - start : 0 ))) " "$R_PUR" "$R_DRK"
    pl_seg " ${G_DISK} $(df -h --output=avail / | tail -1 | tr -d ' ') liberi " "$R_SEG" "$R_TXT"
    pl_end
    echo
}

bye() { printf '  %s%s niente da fare, non e'"'"' stato cancellato niente.%s\n\n' "$C_MUT" "$G_OK" "$RST"; }

draw_header
scan
preview || exit 0
echo
$PREVIEW_ONLY && exit 0
[[ -t 0 ]] || { printf '  %sinput non interattivo: solo anteprima.%s\n' "$C_MUT" "$RST"; exit 0; }
select_cats || { echo; bye; exit 0; }
confirm || { echo; bye; exit 0; }
run_all
