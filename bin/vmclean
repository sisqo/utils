LABEL[chromium]="Cache di Chromium (snap)"; TIER[chromium]=2; SUDO[chromium]=0; ICON[chromium]=$''
DESC[chromium]="cache web su disco (profilo, login e cronologia restano)"
chromium_dirs() {
    local d
    for d in "$H/snap/chromium/common/chromium"/{Default,Profile\ *}/{Cache,Code\ Cache} \
             "$H/snap/chromium/common/.cache"; do
        [[ -d $d ]] && echo "$d"
    done
}
size_chromium() { local p; mapfile -t p < <(chromium_dirs); size_of "${p[@]}"; }
list_chromium() { chromium_dirs; }
run_chromium() { local d; while IFS= read -r d; do empty_dir "$d"; done < <(chromium_dirs); }

LABEL[nextbuild]="Build di Next.js nei progetti"; TIER[nextbuild]=2; SUDO[nextbuild]=0; ICON[nextbuild]=$''
DESC[nextbuild]="cartelle .next sotto ~/git: il prossimo next dev o build riparte da zero"
next_dirs() {
    find "$H/git" -maxdepth 4 \( -name node_modules -prune \) -o \
        \( -type d -name .next -print -prune \) 2>/dev/null
}
size_nextbuild() { local p; mapfile -t p < <(next_dirs); size_of "${p[@]}"; }
list_nextbuild() { next_dirs; }
run_nextbuild() { local d; while IFS= read -r d; do rm -rf -- "$d"; done < <(next_dirs); }

LABEL[hyprbuild]="Sorgenti compilati di Hyprland"; TIER[hyprbuild]=2; SUDO[hyprbuild]=0; ICON[hyprbuild]=$''
DESC[hyprbuild]="alberi scompattati in ~/src/hypr/w: build.sh li riscarica; .deb e tarball restano"
# build.sh fa rm -rf + apt-get source a ogni compilazione, quindi le cartelle
# scompattate si rigenerano; i .deb, i .dsc e i tarball servono a reinstallare.
hyprbuild_dirs() { find "$H/src/hypr/w" -mindepth 2 -maxdepth 2 -type d 2>/dev/null; }
size_hyprbuild() { local p; mapfile -t p < <(hyprbuild_dirs); size_of "${p[@]}"; }
list_hyprbuild() { hyprbuild_dirs; }
