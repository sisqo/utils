#!/usr/bin/env bash
# vmclean — pulizia dei file non necessari della VM, con anteprima prima di cancellare.
#
# Senza argomenti: calcola cosa si puo' liberare, mostra l'anteprima e chiede cosa
# eliminare (di default niente). Con -n / --preview mostra solo l'anteprima ed esce.
# L'anteprima non richiede sudo: sudo serve solo in fase di cancellazione.
# Lo stile (colori, gradiente, glifi, status bar) riprende quello di cla2.
set -uo pipefail

PREVIEW_ONLY=false
# Oltre questo tempo il calcolo di una categoria si considera bloccato (ad
# esempio snap list quando snapd o systemd non rispondono) e si salta.
SCAN_TIMEOUT=${VMCLEAN_TIMEOUT:-20}
[[ $SCAN_TIMEOUT =~ ^[0-9]+$ && $SCAN_TIMEOUT -gt 0 ]] || SCAN_TIMEOUT=20
# Dimensione a cui ridurre il journal di systemd.
JOURNAL_KEEP="200M"

usage() {
    cat <<EOF
Uso: vmclean [-n|--preview] [-h|--help]

  (nessuna opzione)  mostra l'anteprima e chiede cosa eliminare
  -n, --preview      mostra solo l'anteprima, senza cancellare niente
  -h, --help         questo aiuto

VMCLEAN_NOANIM=1 salta le animazioni, NO_COLOR=1 toglie i colori.
VMCLEAN_TIMEOUT=<secondi> e' il tempo massimo di calcolo per categoria (20).
EOF
}

case "${1:-}" in
    "") ;;
    -n|--preview) PREVIEW_ONLY=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

H="${HOME:?HOME non impostata}"

# ── terminale ─────────────────────────────────────────────────────────────────
TTY=0; [[ -t 1 ]] && TTY=1
ANIM=$TTY; [[ -n ${VMCLEAN_NOANIM:-} ]] && ANIM=0
COLS=$(tput cols 2>/dev/null || echo 80); [[ $COLS =~ ^[0-9]+$ ]] || COLS=80
(( TTY )) || COLS=100
# Larghezza dei riquadri (bordi compresi) e larghezza utile al loro interno.
W=$(( COLS - 2 < 100 ? COLS - 2 : 100 ))
IW=$(( W - 4 ))
BARW=0; (( IW >= 60 )) && BARW=10

# ── colori (truecolor, stessa tavolozza di cla2) ──────────────────────────────
E=$'\033'
R_TXT="205;214;244"; R_MUT="108;112;134"; R_BRD="69;71;90"
R_CYN="0;229;255";   R_PNK="255;46;151";  R_PUR="176;75;255";  R_GRN="57;255;130"
R_YLW="255;214;10";  R_RED="255;85;85";   R_DRK="17;17;27";    R_SEG="49;50;68"
COLOR=0; (( TTY )) && [[ -z ${NO_COLOR:-} ]] && COLOR=1
if (( COLOR )); then
    RST="$E[0m"; BLD="$E[1m"; NOB="$E[22m"
    for c in TXT MUT BRD CYN PNK PUR GRN YLW RED; do
        v="R_$c"; printf -v "C_$c" '\033[38;2;%sm' "${!v}"
    done
else
    RST=""; BLD=""; NOB=""
    for c in TXT MUT BRD CYN PNK PUR GRN YLW RED; do printf -v "C_$c" '%s' ""; done
fi

# Gradiente ciclico ciano → viola → rosa → ciano, 48 passi (come in cla2).
GRAD=(); GRAD_DIM=()
stops=("0 229 255" "176 75 255" "255 46 151" "0 229 255")
for (( s=0; s<3; s++ )); do
    read -r r1 g1 b1 <<<"${stops[s]}"
    read -r r2 g2 b2 <<<"${stops[s+1]}"
    for (( t=0; t<16; t++ )); do
        r=$(( r1 + (r2-r1)*t/16 )); g=$(( g1 + (g2-g1)*t/16 )); b=$(( b1 + (b2-b1)*t/16 ))
        if (( COLOR )); then
            printf -v esc '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"; GRAD+=("$esc")
            printf -v esc '\033[38;2;%d;%d;%dm' $((r*45/100)) $((g*45/100)) $((b*45/100)); GRAD_DIM+=("$esc")
        else
            GRAD+=(""); GRAD_DIM+=("")
        fi
    done
done

# Glifi Nerd Font (JetBrainsMono Nerd Font Mono: 1 cella l'uno).
G_SEP_R=$''; G_SEP_L=$''
G_LOCK=$'';  G_DISK=$'';  G_OK=$'';  G_WARN=$''
G_BAN=$'';   G_RECYCLE=$''; G_SHIELD=$''

BANNER=(
    "██╗   ██╗███╗   ███╗ ██████╗██╗     ███████╗ █████╗ ███╗   ██╗"
    "██║   ██║████╗ ████║██╔════╝██║     ██╔════╝██╔══██╗████╗  ██║"
    "██║   ██║██╔████╔██║██║     ██║     █████╗  ███████║██╔██╗ ██║"
    "╚██╗ ██╔╝██║╚██╔╝██║██║     ██║     ██╔══╝  ██╔══██║██║╚██╗██║"
    " ╚████╔╝ ██║ ╚═╝ ██║╚██████╗███████╗███████╗██║  ██║██║ ╚████║"
    "  ╚═══╝  ╚═╝     ╚═╝ ╚═════╝╚══════╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝"
)
BANNER_W=${#BANNER[0]}

TMPD=$(mktemp -d)
cleanup() { (( TTY )) && printf '\033[?25h'; rm -rf -- "$TMPD"; }
trap cleanup EXIT
trap 'echo; exit 130' INT

# ── helper di testo ───────────────────────────────────────────────────────────
# Come in cla2: il testo si tronca *prima* di colorarlo, cosi' la larghezza
# visibile e' sempre nota e nessuna riga sfora il bordo dei riquadri.
trunc() {  # $1 testo, $2 larghezza → _t
    local s=$1 w=$2
    if (( w <= 0 )); then _t=""
    elif (( ${#s} > w )); then _t="${s:0:w-1}…"
    else _t=$s; fi
}
spaces() { printf -v _s '%*s' "$(( $1 > 0 ? $1 : 0 ))" ''; }
hr()     { spaces "$1"; _hr=${_s// /─}; }
lpad()   { spaces $(( $2 - ${#1} )); _l="$_s$1"; }
rpad()   { spaces $(( $2 - ${#1} )); _r="$1$_s"; }

human() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }

# Barra ▰▱ colorata verde → giallo → rosso in base alla percentuale (da cla2).
meter() {  # $1 percentuale, $2 celle → _m
    local pct=$1 n=$2 on k col
    on=$(( (pct * n + 50) / 100 ))
    _m=""
    for (( k=0; k<n; k++ )); do
        if (( k < on )); then
            if (( k < n/2 )); then col=$C_GRN; elif (( k < n*8/10 )); then col=$C_YLW; else col=$C_RED; fi
            _m+="${col}▰"
        else
            _m+="${C_BRD}▱"
        fi
    done
    _m+=$RST
}

# Barra a gradiente proporzionale alla categoria piu' grande.
gbar() {  # $1 valore, $2 massimo, $3 celle → _b
    local v=$1 max=$2 n=$3 on k
    (( max > 0 )) || max=1
    on=$(( (v * n + max / 2) / max ))
    (( v > 0 && on == 0 )) && on=1
    _b=""
    for (( k=0; k<n; k++ )); do
        if (( k < on )); then _b+="${GRAD[k * 32 / n]}▰"; else _b+="${C_BRD}▱"; fi
    done
    _b+=$RST
}

# ── riquadri ──────────────────────────────────────────────────────────────────
box_top() {  # $1 titolo, $2 colore del titolo
    local t=" $1 "
    hr $(( W - 3 - ${#t} ))
    printf ' %s╭─%s%s%s%s%s%s╮%s\n' "$C_BRD" "$RST" "$2$BLD" "$t" "$RST" "$C_BRD" "$_hr" "$RST"
}
box_line() {  # $1 contenuto colorato, $2 sua larghezza visibile
    spaces $(( IW - $2 ))
    printf ' %s│%s %s%s %s│%s\n' "$C_BRD" "$RST" "$1" "$_s" "$C_BRD" "$RST"
}
box_bot() { hr $(( W - 2 )); printf ' %s╰%s╯%s\n' "$C_BRD" "$_hr" "$RST"; }

# Segmenti powerline, come la status bar di cla2 (senza colori: [ a | b ]).
PL=""; PL_BG=""
pl_seg() {  # $1 testo, $2 bg "r;g;b", $3 fg "r;g;b"
    if (( ! COLOR )); then PL+="${PL:+|}$1"; return; fi
    [[ -n $PL_BG ]] && PL+="$E[38;2;${PL_BG}m$E[48;2;$2m${G_SEP_R}"
    PL+="$E[48;2;$2m$E[38;2;$3m$1"; PL_BG=$2
}
pl_end() {
    if (( COLOR )); then PL+="$E[0m$E[38;2;${PL_BG}m${G_SEP_R}$RST"; else PL="[$PL]"; fi
    printf '  %s\n' "$PL"; PL=""; PL_BG=""
}

hint() { printf '%s%s%s%s %s%s  ' "$C_TXT" "$BLD" "$1" "$NOB" "$C_MUT" "$2"; }

# ── utilita' di sistema ───────────────────────────────────────────────────────

# Somma in byte delle dimensioni dei percorsi esistenti (quelli mancanti valgono 0).
size_of() {
    local p total=0 s
    for p in "$@"; do
        [[ -e "$p" ]] || continue
        s=$(du -sb -- "$p" 2>/dev/null | cut -f1)
        total=$((total + ${s:-0}))
    done
    echo "$total"
}

# Svuota una cartella lasciandola in piedi (i programmi si aspettano che esista).
empty_dir() {
    local d="$1"
    [[ -d "$d" && "$d" == /* && "$d" != / ]] || return 0
    find "$d" -mindepth 1 -delete
}

# Processi antenati di vmclean (la shell o il terminale che l'ha lanciato): la
# loro riga di comando puo' contenere i nomi cercati, e non vanno contati. Lo
# stesso vale per le loro copie (bash crea sottoshell per gli elementi di una
# pipe), riconoscibili perche' hanno la stessa riga di comando.
ANCESTORS=" "; ANCESTOR_CMDS=()
_p=$$
while [[ $_p =~ ^[0-9]+$ ]] && (( _p > 1 )); do
    ANCESTORS+="$_p "
    ANCESTOR_CMDS+=("$(tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null)")
    _st=$(< "/proc/$_p/stat") 2>/dev/null || break
    _st=${_st##*) }; read -r _ _p _ <<<"$_st"
done

# Termina un processo e tutti i suoi discendenti (prima i figli).
kill_tree() {
    local c
    for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done
    kill "$1" 2>/dev/null
}

running() {
    local pid cmd a
    for pid in $(pgrep -f -- "$1" 2>/dev/null); do
        [[ $ANCESTORS == *" $pid "* ]] && continue
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
        for a in "${ANCESTOR_CMDS[@]}"; do [[ $cmd == "$a" ]] && continue 2; done
        return 0
    done
    return 1
}

# Le funzioni run_* segnalano cosi' qualcosa da mostrare sotto il passo.
note() { echo "NOTA: $*"; }

disk_avail() { df -B1 --output=avail / | tail -1 | tr -d ' '; }
disk_pct()   { df --output=pcent / | tail -1 | tr -dc '0-9'; }

# ── cartelle JetBrains ────────────────────────────────────────────────────────
# Le cartelle per-versione hanno la forma <Prodotto><anno>.<n> (es. IntelliJIdea2026.1);
# per ogni prodotto la versione piu' recente e' quella in uso, le altre sono vecchie.
JB_BASES=("$H/.cache/JetBrains" "$H/.config/JetBrains" "$H/.local/share/JetBrains")

jb_versioned() {
    local base
    for base in "${JB_BASES[@]}"; do
        [[ -d "$base" ]] || continue
        find "$base" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended \
            -regex '.*/[A-Za-z]+[0-9]{4}\.[0-9]+' -printf '%f\n'
    done | sort -u
}

# Versione piu' recente per ogni prodotto.
jb_latest() {
    jb_versioned | sed -E 's/^([A-Za-z]+)([0-9]{4}\.[0-9]+)$/\1 \2/' \
        | sort -k1,1 -k2,2V | awk '{last[$1]=$1$2} END {for (p in last) print last[p]}'
}

jb_old_paths() {
    local latest base d
    latest=$(jb_latest)
    for base in "${JB_BASES[@]}"; do
        [[ -d "$base" ]] || continue
        while IFS= read -r d; do
            grep -qxF -- "$d" <<<"$latest" || echo "$base/$d"
        done < <(jb_versioned)
    done | while IFS= read -r d; do [[ -d "$d" ]] && echo "$d"; done
}

jb_cache_paths() {
    local d
    while IFS= read -r d; do
        [[ -d "$H/.cache/JetBrains/$d" ]] && echo "$H/.cache/JetBrains/$d"
    done < <(jb_latest)
}

# ── snap ──────────────────────────────────────────────────────────────────────
# Revisioni disabilitate: snapd tiene le vecchie versioni dopo ogni aggiornamento.
snap_disabled() {
    command -v snap >/dev/null || return 0
    snap list --all 2>/dev/null | awk 'NR > 1 && $NF ~ /disabled/ {print $1, $3}'
}

# ── categorie ─────────────────────────────────────────────────────────────────
# Ogni categoria ha: etichetta, icona, livello (1 = consigliata, 2 = opzionale),
# se serve sudo, una descrizione, e le funzioni size_<id> / list_<id> / run_<id>.
# SKIP[<id>] (se non vuota) spiega perche' la categoria e' saltata.

CATS=(npm pip thumbs claudever claudedl ccache vscode headless
      snap apt autoremove rcpkgs journal oldlogs crash
      jbcache browsers chrome chromium nextbuild hyprbuild claudejobs chromiumsnap
      jbold trash cliphist)

declare -A LABEL ICON TIER SUDO DESC SIZE SKIP TIMEDOUT

LABEL[npm]="Cache npm e npx";            TIER[npm]=1; SUDO[npm]=0; ICON[npm]=$''
DESC[npm]="pacchetti scaricati, npm/npx li riscaricano quando servono"
size_npm() { size_of "$H/.npm/_cacache" "$H/.npm/_npx" "$H/.npm/_logs"; }
list_npm() { printf '%s\n' "$H/.npm/_cacache" "$H/.npm/_npx" "$H/.npm/_logs"; }
run_npm() {
    rm -rf -- "$H/.npm/_cacache" "$H/.npm/_logs"
    # _npx contiene anche i pacchetti dei server MCP avviati con npx: se uno e'
    # in esecuzione non lo si tocca.
    if running "$H/.npm/_npx"; then
        note "_npx in uso da un processo: lasciata intatta"
    else
        rm -rf -- "$H/.npm/_npx"
    fi
}

LABEL[pip]="Cache pip";                  TIER[pip]=1; SUDO[pip]=0; ICON[pip]=$''
DESC[pip]="wheel scaricate da pip"
size_pip() { size_of "$H/.cache/pip"; }
list_pip() { echo "$H/.cache/pip"; }
run_pip() { empty_dir "$H/.cache/pip"; }

LABEL[thumbs]="Miniature";               TIER[thumbs]=1; SUDO[thumbs]=0; ICON[thumbs]=$''
DESC[thumbs]="anteprime delle immagini, rigenerate al bisogno"
size_thumbs() { size_of "$H/.cache/thumbnails"; }
list_thumbs() { echo "$H/.cache/thumbnails"; }
run_thumbs() { empty_dir "$H/.cache/thumbnails"; }

LABEL[claudever]="Versioni vecchie di Claude Code"; TIER[claudever]=1; SUDO[claudever]=0; ICON[claudever]=$''
DESC[claudever]="binari lasciati dagli aggiornamenti (restano l'attuale e quelle in uso)"
# La versione attiva e' quella puntata da ~/.local/bin/claude; si salvano anche
# quelle che una sessione aperta sta ancora eseguendo.
claudever_paths() {
    local cur used f
    cur=$(readlink -f "$H/.local/bin/claude" 2>/dev/null)
    [[ -n $cur ]] || return 0
    used=$(for f in /proc/[0-9]*/exe; do readlink "$f"; done 2>/dev/null | sort -u)
    for f in "$H/.local/share/claude/versions"/*; do
        [[ -f $f && $f != "$cur" ]] || continue
        grep -qxF -- "$f" <<<"$used" && continue
        echo "$f"
    done
}
size_claudever() { local p; mapfile -t p < <(claudever_paths); size_of "${p[@]}"; }
list_claudever() { claudever_paths; }
run_claudever() { local f; while IFS= read -r f; do rm -f -- "$f"; done < <(claudever_paths); }

LABEL[claudedl]="Download vecchi di Claude Code"; TIER[claudedl]=1; SUDO[claudedl]=0; ICON[claudedl]=$''
DESC[claudedl]="installer gia' usati in ~/.claude/downloads (quelli di oggi restano)"
claudedl_paths() { find "$H/.claude/downloads" -mindepth 1 -maxdepth 1 -mtime +0 2>/dev/null; }
size_claudedl() { local p; mapfile -t p < <(claudedl_paths); size_of "${p[@]}"; }
list_claudedl() { claudedl_paths; }
run_claudedl() { local f; while IFS= read -r f; do rm -rf -- "$f"; done < <(claudedl_paths); }

LABEL[ccache]="Cache di Claude Desktop";  TIER[ccache]=1; SUDO[ccache]=0; ICON[ccache]=$''
DESC[ccache]="cache web e GPU dell'app (conversazioni e login restano)"
CCACHE_DIRS=("$H/.config/Claude/Cache" "$H/.config/Claude/Code Cache" "$H/.config/Claude/GPUCache")
size_ccache() { size_of "${CCACHE_DIRS[@]}"; }
list_ccache() { printf '%s\n' "${CCACHE_DIRS[@]}"; }
run_ccache() { local d; for d in "${CCACHE_DIRS[@]}"; do empty_dir "$d"; done; }

LABEL[vscode]="Cache di VS Code";         TIER[vscode]=1; SUDO[vscode]=0; ICON[vscode]=$''
DESC[vscode]="cache web, dati compilati e pacchetti delle estensioni gia' installate"
VSCODE_DIRS=("$H/.config/Code/Cache" "$H/.config/Code/CachedData" "$H/.config/Code/CachedExtensionVSIXs")
size_vscode() { size_of "${VSCODE_DIRS[@]}"; }
list_vscode() { printf '%s\n' "${VSCODE_DIRS[@]}"; }
run_vscode() { local d; for d in "${VSCODE_DIRS[@]}"; do empty_dir "$d"; done; }

LABEL[headless]="Profili temporanei di Chrome headless"; TIER[headless]=1; SUDO[headless]=0; ICON[headless]=$''
DESC[headless]="cartelle scoped_dir lasciate dalle sessioni headless"
size_headless() { size_of "$H/.cache/google-chrome-headless"; }
list_headless() { echo "$H/.cache/google-chrome-headless"; }
run_headless() { empty_dir "$H/.cache/google-chrome-headless"; }

LABEL[snap]="Revisioni snap disabilitate"; TIER[snap]=1; SUDO[snap]=1; ICON[snap]=$''
DESC[snap]="vecchie versioni degli snap: dopo non si puo' piu' fare snap revert"
size_snap() {
    local name rev total=0 f
    while read -r name rev; do
        [[ -n "$name" ]] || continue
        f="/var/lib/snapd/snaps/${name}_${rev}.snap"
        [[ -f "$f" ]] && total=$((total + $(stat -c %s -- "$f")))
    done < <(snap_disabled)
    echo "$total"
}
list_snap() { snap_disabled | awk '{print $1 "@" $2}' | paste -sd' ' | fold -s -w $(( IW - 8 )); }
run_snap() {
    local name rev
    while read -r name rev; do
        [[ -n "$name" ]] || continue
        sudo snap remove "$name" --revision="$rev"
    done < <(snap_disabled)
}

LABEL[apt]="Cache apt";                  TIER[apt]=1; SUDO[apt]=1; ICON[apt]=$''
DESC[apt]="pacchetti .deb gia' installati (apt-get clean)"
size_apt() { size_of /var/cache/apt/archives /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin; }
list_apt() { echo "/var/cache/apt  → sudo apt-get clean"; }
run_apt() { sudo apt-get clean; }

LABEL[autoremove]="Pacchetti apt orfani"; TIER[autoremove]=1; SUDO[autoremove]=1; ICON[autoremove]=$''
DESC[autoremove]="dipendenze non piu' richieste da nessun pacchetto"
# I kernel vecchi restano: apt li segna rimovibili dopo ogni aggiornamento del
# kernel, ma quello precedente e' il fallback voluto da Ubuntu.
autoremove_pkgs() {
    apt-get -s autoremove 2>/dev/null | awk '/^Remv/ {print $2}' | grep -vE '^linux-'
}
size_autoremove() {
    local pkgs kb
    pkgs=$(autoremove_pkgs)
    [[ -n "$pkgs" ]] || { echo 0; return; }
    # shellcheck disable=SC2086
    kb=$(dpkg-query -W -f='${Installed-Size}\n' $pkgs 2>/dev/null | awk '{s+=$1} END {print s+0}')
    echo $((kb * 1024))
}
list_autoremove() { autoremove_pkgs; }
# shellcheck disable=SC2046
run_autoremove() { sudo apt-get -y remove --autoremove $(autoremove_pkgs); }

LABEL[rcpkgs]="Residui di pacchetti rimossi"; TIER[rcpkgs]=1; SUDO[rcpkgs]=1; ICON[rcpkgs]=$''
DESC[rcpkgs]="configurazioni di pacchetti gia' disinstallati e moduli di kernel vecchi"
rc_pkgs() { dpkg -l 2>/dev/null | awk '$1 == "rc" {print $2}'; }
# Cartelle in /lib/modules di kernel non piu' installati (mai quella in uso).
orphan_modules() {
    local d v
    for d in /lib/modules/*/; do
        v=$(basename "$d")
        [[ $v =~ ^[0-9] && $v != "$(uname -r)" ]] || continue
        dpkg -l "linux-modules-$v" "linux-image-$v" 2>/dev/null | grep -q '^ii' && continue
        echo "/lib/modules/$v"
    done
}
# I file di configurazione non si misurano: si stimano 4K per pacchetto.
size_rcpkgs() {
    local p n
    mapfile -t p < <(orphan_modules)
    n=$(rc_pkgs | wc -l)
    echo $(( $(size_of "${p[@]}") + n * 4096 ))
}
list_rcpkgs() {
    local n
    n=$(rc_pkgs | wc -l)
    (( n )) && echo "$n pacchetti da purgare (dpkg --purge)"
    orphan_modules
}
run_rcpkgs() {
    local d pkgs
    mapfile -t pkgs < <(rc_pkgs)
    (( ${#pkgs[@]} )) && sudo dpkg --purge "${pkgs[@]}"
    while IFS= read -r d; do sudo rm -rf -- "$d"; done < <(orphan_modules)
}

LABEL[journal]="Journal di systemd";     TIER[journal]=1; SUDO[journal]=1; ICON[journal]=$''
DESC[journal]="log di sistema, ridotti a $JOURNAL_KEEP (i piu' recenti restano)"
size_journal() {
    local used keep
    used=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]?B?' | head -1)
    used=$(numfmt --from=iec "${used%B}" 2>/dev/null || echo 0)
    keep=$(numfmt --from=iec "$JOURNAL_KEEP")
    (( used > keep )) && echo $((used - keep)) || echo 0
}
list_journal() { echo "sudo journalctl --vacuum-size=$JOURNAL_KEEP"; }
run_journal() { sudo journalctl --vacuum-size="$JOURNAL_KEEP"; }

LABEL[oldlogs]="Log ruotati";            TIER[oldlogs]=1; SUDO[oldlogs]=1; ICON[oldlogs]=$''
DESC[oldlogs]="vecchi log compressi o numerati in /var/log"
oldlogs_find() {
    find /var/log -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) "$@" 2>/dev/null
}
size_oldlogs() { oldlogs_find -printf '%s\n' | awk '{s+=$1} END {print s+0}'; }
list_oldlogs() { oldlogs_find; }
# Cancella esattamente i file mostrati in anteprima (cercati senza sudo), non
# quelli che un find con sudo troverebbe anche nelle cartelle riservate a root.
# find esce con 1 sulle cartelle non leggibili: non e' un errore della pulizia.
run_oldlogs() { { oldlogs_find -print0 || true; } | sudo xargs -0 -r rm -f --; }

LABEL[crash]="Crash report";             TIER[crash]=1; SUDO[crash]=1; ICON[crash]=$''
DESC[crash]="dump di programmi andati in crash"
size_crash() { size_of /var/crash/*; }
list_crash() { find /var/crash -mindepth 1 -maxdepth 1 2>/dev/null; }
run_crash() { sudo find /var/crash -mindepth 1 -delete; }

LABEL[jbcache]="Cache dell'IDE JetBrains in uso"; TIER[jbcache]=2; SUDO[jbcache]=0; ICON[jbcache]=$''
DESC[jbcache]="indici e cache: al prossimo avvio l'IDE reindicizza tutto (lento)"
size_jbcache() { local p; mapfile -t p < <(jb_cache_paths); size_of "${p[@]}"; }
list_jbcache() { jb_cache_paths; }
run_jbcache() { local d; while IFS= read -r d; do empty_dir "$d"; done < <(jb_cache_paths); }

LABEL[browsers]="Browser di Playwright e Puppeteer"; TIER[browsers]=2; SUDO[browsers]=0; ICON[browsers]=$''
