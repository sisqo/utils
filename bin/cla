#!/usr/bin/env bash
# cla — scegli un progetto (cartella corrente, o una sotto ~/git) e avviaci claude dentro.
set -euo pipefail

GIT_DIR="$HOME/git"
CURRENT_DIR="$(pwd)"

RESET=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
CYAN=$'\033[36m'
MAGENTA=$'\033[35m'
YELLOW=$'\033[33m'
GREEN=$'\033[32m'

cd "$GIT_DIR"

# La prima scelta e' sempre la cartella corrente (da cui e' stato lanciato cla);
# tutte le altre sono le cartelle sotto ~/git.
names=("$(basename "$CURRENT_DIR")")
paths=("$CURRENT_DIR")

for d in */; do
    d="${d%/}"
    [[ "$d" == .* ]] && continue
    full="$GIT_DIR/$d"
    [[ "$full" == "$CURRENT_DIR" ]] && continue
    names+=("$d")
    paths+=("$full")
done

# Colore /color deterministico dal nome progetto: stesso progetto, stesso colore ogni volta.
PALETTE=(red blue green yellow purple orange pink cyan)
project_color() {
    local name="$1" sum=0 i c
    for (( i=0; i<${#name}; i++ )); do
        c="${name:i:1}"
        sum=$(( sum + $(printf '%d' "'$c") ))
    done
    echo "${PALETTE[$(( sum % ${#PALETTE[@]} ))]}"
}

launch_claude() {
    local path="$1" name="$2" color rename_text
    # Il colore resta legato al nome della cartella, non al nome scelto per la
    # sessione: stesso progetto, stesso colore ogni volta.
    color="$(project_color "$name")"

    # La CLI di claude accetta un solo prompt iniziale, gia' occupato da
    # "/color": il nome sessione (equivalente a /rename) si imposta con -n.
    read -e -r -i "$name" -p "Rinomina sessione: " rename_text || true
    rename_text="${rename_text:-$name}"

    cd "$path"

    if git rev-parse --is-inside-work-tree &>/dev/null; then
        echo -e "${DIM}  git pull...${RESET}"
        git pull --ff-only || echo -e "${YELLOW}  Attenzione: git pull fallito, procedo comunque${RESET}"
    fi

    echo -e "\n${GREEN}${BOLD}➜ Avvio claude in${RESET} ${CYAN}$(pwd)${RESET} ${DIM}(colore ${color}, remote control attivo)${RESET}\n"
    # Path assoluto: i bind exec di Hyprland non ereditano ~/.local/bin nel PATH.
    exec /home/user/.local/bin/claude --remote-control "$rename_text" -n "$rename_text" "/color $color"
}

banner() {
    echo -e "${MAGENTA}${BOLD}"
    cat <<'EOF'
 ██████╗██╗      █████╗ ██╗   ██╗██████╗ ███████╗
██╔════╝██║     ██╔══██╗██║   ██║██╔══██╗██╔════╝
██║     ██║     ███████║██║   ██║██║  ██║█████╗
██║     ██║     ██╔══██║██║   ██║██║  ██║██╔══╝
╚██████╗███████╗██║  ██║╚██████╔╝██████╔╝███████╗
 ╚═════╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝
EOF
    echo -e "${RESET}${DIM}  ~/git · scegli un progetto${RESET}\n"
}

# Tasti rapidi per la selezione diretta: 1-9 poi lettere (esclusa 'q', riservata per uscire).
keys="123456789abcdefghijklmnoprstuvwxyz"
quickkeys=()
for i in "${!names[@]}"; do
    if [ "$i" -lt "${#keys}" ]; then
        quickkeys+=("${keys:$i:1}")
    else
        quickkeys+=("")
    fi
done

# Se non c'e' un terminale interattivo (piped/redirect), fallback a select classico.
if [ ! -t 0 ]; then
    banner
    PS3="Scegli un progetto: "
    select name in "${names[@]}"; do
        [ -n "${name:-}" ] && break
        echo "Scelta non valida."
    done
    idx=$((REPLY - 1))
    launch_claude "${paths[$idx]}" "${names[$idx]}"
fi

selected=0
count=${#names[@]}

draw_menu() {
    for i in "${!names[@]}"; do
        key_label="${quickkeys[$i]:--}"
        label="${names[$i]}"
        [ "$i" -eq 0 ] && label="${label} ${DIM}(cartella corrente)${RESET}"
        if [ "$i" -eq "$selected" ]; then
            echo -e "  ${CYAN}${BOLD}❯ ${YELLOW}${key_label}${RESET}  ${CYAN}${BOLD}${label}${RESET}"
        else
            echo -e "    ${DIM}${key_label}  ${label}${RESET}"
        fi
    done
}

tput civis
trap 'tput cnorm' EXIT

banner
echo -e "${DIM}  ↑/↓ per muoverti · invio per confermare · numero/lettera per scelta rapida · q per uscire${RESET}\n"
draw_menu

while true; do
    IFS= read -rsn1 key

    if [[ $key == $'\x1b' ]]; then
        read -rsn2 key
        case "$key" in
            '[A') selected=$(( (selected - 1 + count) % count )) ;;
            '[B') selected=$(( (selected + 1) % count )) ;;
        esac
    elif [[ -z $key ]]; then
        break
    else
        key="${key,,}"
        if [[ $key == "q" ]]; then
            tput cnorm
            exit 0
        fi
        match=-1
        for i in "${!quickkeys[@]}"; do
            if [[ -n "${quickkeys[$i]}" && "${quickkeys[$i]}" == "$key" ]]; then
                match=$i
                break
            fi
        done
        if [ "$match" -ge 0 ]; then
            selected=$match
            break
        fi
    fi

    tput cuu "$count"
    draw_menu
done

tput cnorm

launch_claude "${paths[$selected]}" "${names[$selected]}"
